{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blotter",
  "mainBinaryName": "blotter",
  "version": "0.1.0",
  "identifier": "io.github.lasr0.Blotter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blotter",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "backgroundColor": "#121317"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Keyboard-first daily planner",
    "longDescription": "A keyboard-first daily planner with an AI that pencils things in for you.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

[Desktop Entry]
Type=Application
Name=Blotter
GenericName=Daily planner
Comment=Keyboard-first daily planner with an AI that pencils things in for you
Exec=blotter
Icon=io.github.lasr0.Blotter
Terminal=false
Categories=Office;Calendar;ProjectManagement;
Keywords=planner;calendar;tasks;todo;diary;schedule;
